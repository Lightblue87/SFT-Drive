# Supabase Projekt-Zugangsdaten.
# Nur den öffentlichen anon/publishable Key verwenden — niemals den service_role Key im Frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Öffentlicher VAPID-Schlüssel für Web Push (siehe CLAUDE.md §27.15/§27.16).
# Ungefährlich im Client — das Gegenstück (VAPID_PRIVATE_KEY) liegt ausschließlich
# als Secret der Supabase Edge Function "send-push", niemals im Frontend.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
